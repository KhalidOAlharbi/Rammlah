OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

LATITUDE=
LONGITUDE=

CAMERA_ENABLED=true
ROBOT_ENABLED=false

ROBOT_SERIAL_PORT=/dev/ttyUSB0
ROBOT_BAUD_RATE=9600

FORWARD_TIMEOUT_SECONDS=60
RETURN_TIMEOUT_SECONDS=60

SCAN_INTERVAL_SECONDS=30

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=INFO
