OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=45
MAX_IMAGE_DIMENSION=1280
RASPBERRY_PI_AGENT_TOKEN=

LATITUDE=24.7136
LONGITUDE=46.6753

# Keep both disabled for DigitalOcean/cloud dashboard testing.
# Enable only on the Raspberry Pi after hardware wiring and safety tests.
CAMERA_ENABLED=false
CAMERA_CAPTURE_WIDTH=1280
CAMERA_CAPTURE_HEIGHT=720
ROBOT_ENABLED=false
ROBOT_CONTROLLER=serial                             

ROBOT_SERIAL_PORT=/dev/ttyUSB0
ROBOT_BAUD_RATE=9600

FORWARD_TIMEOUT_SECONDS=5
RETURN_TIMEOUT_SECONDS=5
ROBOT_DRIVE_SPEED=0.20
ROBOT_BRUSH_SPEED=1.00
ROBOT_PWM_FREQUENCY_HZ=1000
ROBOT_BRUSH_LEAD_SECONDS=2.0

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://raspberrypi.local,http://raspberrypi.local:5173,https://rammlah-app-d57uq.ondigitalocean.app
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|raspberrypi\.local|172\.20\.10\.\d+|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|rammlah-app-d57uq\.ondigitalocean\.app)(:\d+)?$

LOG_LEVEL=INFO
