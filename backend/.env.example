OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=45
MAX_IMAGE_DIMENSION=1280
RASPBERRY_PI_AGENT_TOKEN=

LATITUDE=24.7136
LONGITUDE=46.6753

# Keep both disabled for DigitalOcean/cloud dashboard testing.
# Enable only on the Raspberry Pi after hardware wiring and safety tests.
CAMERA_ENABLED=false
ROBOT_ENABLED=false

ROBOT_SERIAL_PORT=/dev/ttyUSB0
ROBOT_BAUD_RATE=9600
FORWARD_TIMEOUT_SECONDS=60
RETURN_TIMEOUT_SECONDS=60
SCAN_INTERVAL_SECONDS=30
FOLLOW_UP_SCAN_DELAY_SECONDS=2

# Replace the production URL with your deployed dashboard URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-dashboard-url
LOG_LEVEL=INFO
